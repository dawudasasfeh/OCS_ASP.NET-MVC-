@model List<Student>

<h2 class="mb-3">Students List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Student</a>

<table class="table table-striped table-bordered table-hover students-table">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Age</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

