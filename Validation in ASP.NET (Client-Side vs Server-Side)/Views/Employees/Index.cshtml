@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employees List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Employees List</h2>
        <a asp-action="Create" class="btn btn-success">+ Add New Employee</a>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>Salary</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var emp in Model)
                {
                    <tr>
                        <td>@emp.Id</td>
                        <td>@emp.FullName</td>
                        <td>@emp.Email</td>
                        <td>@emp.Age</td>
                        <td>@emp.Salary.ToString("C")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No employees found. Click "+ Add New Employee" to create one.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
