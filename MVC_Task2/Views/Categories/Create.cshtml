@{
}
@model Category

@* Link to your custom Category form styling asset sheets folder location *@
<link rel="stylesheet" href="~/css/Categories/Create.css" asp-append-version="true" />

<div class="form-container">
    <h2 class="form-title">Create New Category</h2>

    <form asp-controller="Categories" asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <label>Category Name:</label>
            <input asp-for="Name" class="form-control" placeholder="Enter category name" required />
        </div>

        <div class="form-group">
            <label>Category Icon / Image:</label>
            @* Transmits selected media binary structure block directly through 'imageFile' input names *@
            <input type="file" id="imageFile" name="imageFile" accept="image/*" class="form-control" required />
        </div>

        <button type="submit" class="btn-submit">Submit Category</button>
    </form>
</div>
