@{
}
@model Category

@* Reuses the structured Category layout asset definitions *@
<link rel="stylesheet" href="~/css/Categories/Create.css" asp-append-version="true" />

<div class="form-container">
    <h2 class="form-title">Edit Category</h2>

    <form asp-controller="Categories" asp-action="Edit" method="post" enctype="multipart/form-data">

        @* Prevents data corruption tracking logic drops during database state shifts *@
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label>Category ID:</label>
            <input type="text" class="form-control" value="@Model.Id" disabled style="background-color: #f1f5f9; cursor: not-allowed;" />
        </div>

        <div class="form-group">
            <label>Category Name:</label>
            <input asp-for="Name" class="form-control" placeholder="Enter category name" required />
        </div>

        <div class="form-group">
            <label>Category Icon / Image (Leave blank to keep current):</label>
            @* Stripped the required flag tag component block to prevent forcing user asset re-uploads *@
            <input type="file" id="imageFile" name="imageFile" accept="image/*" class="form-control" />
        </div>

        <button type="submit" class="btn-submit">Save Changes</button>
    </form>
</div>
