@model List<Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@(ViewBag.Category != null ? $"{ViewBag.Category} Products" : "All Products")</h2>
            @if (ViewBag.Category != null)
            {
                <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-secondary btn-sm mt-1">
                    &larr; Back to Categories
                </a>
            }
        </div>
        <a asp-action="Create" class="btn btn-success">+ Create Product</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No products found.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.ImgPath" 
                             class="card-img-top" 
                             alt="@item.Name" 
                             style="height: 200px; object-fit: cover;"
                             onerror="this.src='/images/placeholder.png';">

                        <div class="card-body d-flex flex-column text-center">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="text-muted fw-bold mb-3">$@item.Price</p>

                            <div class="mt-auto">
                                <a asp-action="ViewProduct" asp-route-id="@item.Id" class="btn btn-primary w-100 mb-2">
                                    View Details
                                </a>

                                <div class="btn-group w-100">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure?');">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
