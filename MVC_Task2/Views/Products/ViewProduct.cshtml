@model Product

@{
    ViewData["Title"] = Model?.Name ?? "Product Details";
}

<div class="container mt-4">
    @if (Model == null)
    {
        <div class="alert alert-danger text-center">
            <h4>Product Not Found</h4>
            <a asp-action="Index" class="btn btn-primary mt-2">Back to Products</a>
        </div>
    }
    else
    {
        <!-- Back Navigation -->
        <div class="mb-3">
            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-secondary btn-sm">
                &larr; Back to Products
            </a>
        </div>

        <!-- Single Product Details Card -->
        <div class="card shadow-sm">
            <div class="row g-0">
                <!-- Product Image -->
                <div class="col-md-5">
                    <img src="@Model.ImgPath" 
                         class="img-fluid rounded-start w-100 h-100" 
                         alt="@Model.Name" 
                         style="min-height: 300px; max-height: 450px; object-fit: cover;"
                         onerror="this.src='/images/placeholder.png';">
                </div>

                <!-- Product Information -->
                <div class="col-md-7">
                    <div class="card-body p-4 d-flex flex-column h-100">
                        @if (Model.Category != null)
                        {
                            <span class="badge bg-secondary mb-2 align-self-start">
                                @Model.Category.Name
                            </span>
                        }

                        <h2 class="card-title fw-bold mb-3">@Model.Name</h2>

                        <h3 class="text-primary fw-bold mb-3">$@Model.Price</h3>

                        <div class="mb-4">
                            <p class="mb-1">
                                <strong>Availability:</strong> 
                                @if (Model.Stock > 0)
                                {
                                    <span class="badge bg-success">In Stock (@Model.Stock units)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </p>
                            <p class="mb-1"><strong>Product ID:</strong> #@Model.Id</p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-auto pt-3 border-top d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit Product</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger" onclick="return confirm('Are you sure?');">Delete</a>
                            <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary ms-auto">All Categories</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
