@model Product

@* Link to your new create form external stylesheet *@
<link rel="stylesheet" href="~/css/Products/Create.css" asp-append-version="true" />

<div class="form-container">
    <h2 class="form-title">Create New Product</h2>

    @* Added enctype attribute so file bytes stream to your controller backend *@
    <form asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <label>Name:</label>
            <input asp-for="Name" class="form-control" placeholder="Enter product name" required />
        </div>

        <div class="form-group">
            <label>Price:</label>
            <input type="number" step="0.01" asp-for="Price" class="form-control" placeholder="0.00" required />
        </div>

        <div class="form-group">
            <label>Stock:</label>
            <input type="number" asp-for="Stock" class="form-control" placeholder="0" required />
        </div>

        <div class="form-group">
            <label>Category:</label>
            <select asp-for="CategoryId" class="form-control" required>
                <option value="">-- Select Category --</option>
                @foreach (var item in (List<Category>)ViewBag.Categories)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label>Product Image:</label>
            @* CRITICAL FIXED ELEMENTS: changed type to "file", name matching, and dropped path binding directly *@
            <input type="file" id="imageFile" name="imageFile" accept="image/*" class="form-control" required />
        </div>

        <button type="submit" class="btn-submit">Submit Product</button>
    </form>
</div>
