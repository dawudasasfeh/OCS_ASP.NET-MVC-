@{
    ViewData["Title"] = "Toast Practice Playground";
}


<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body p-4">
                <h4 class="card-title text-success">📦 Products Feature</h4>
                <p class="card-text text-muted">
                    Test <strong>Success</strong> toast (when a new product is added) and <strong>Warning</strong> toast (when a product is deleted).
                </p>
                <div class="d-flex gap-2 mt-3">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">View Products</a>
                    <a asp-controller="Products" asp-action="Create" class="btn btn-success">➕ Add Product</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0 bg-light">
            <div class="card-body p-4">
                <h4 class="card-title text-danger">🔐 Login Feature</h4>
                <p class="card-text text-muted">
                    Test <strong>Error</strong> toast (when invalid credentials are submitted) and <strong>Success</strong> toast (when logging in with <code>admin@example.com</code> / <code>123456</code>).
                </p>
                <div class="mt-3">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-dark">Go to Login Page</a>
                </div>
            </div>
        </div>
    </div>
</div>

